+
+.flat.toggle {
+  color: #575D6D;
+}
+
+.separator {
+  margin: 20px 0px;
+  border-bottom: solid 1px rgba(179, 186, 221, 0.5);
+}
+
+.main-box {
+  background-color: rgba(240, 243, 249, 0.98);
+  box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.25);
+  border-radius: 16px;
+  padding: 24px 20px;
+  padding-bottom: 20px;
+  min-width: 340px;
+}
+
+.box-start {
+  background-color: rgba(240, 243, 249, 0.0);
+  min-height: 32px;
+  border-radius: 12px;
